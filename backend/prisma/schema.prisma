generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  TECHNICIAN
  VIEWER
}

enum MachineStatus {
  ACTIVE
  IN_MAINTENANCE
  INACTIVE
  DECOMMISSIONED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceCategory {
  PREVENTIVE
  CORRECTIVE
}

enum AlertType {
  UPCOMING
  OVERDUE
  CUSTOM
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(VIEWER)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  maintenances       Maintenance[]   @relation("TechnicianMaintenances")
  alertsRead         Alert[]         @relation("AlertReader")
  auditLogs          AuditLog[]
  notifications      Notification[]
  readNotifications  Notification[]  @relation("NotificationReader")

  @@map("users")
}

model MachineType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  machines Machine[]

  @@map("machine_types")
}

model Machine {
  id                 String        @id @default(uuid())
  code               String        @unique
  name               String
  machineTypeId      String        @map("machine_type_id")
  brand              String
  model              String
  serialNumber       String?       @map("serial_number")
  year               Int?
  dailyHoursAverage  Float         @default(8) @map("daily_hours_average")
  status             MachineStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  machineType  MachineType   @relation(fields: [machineTypeId], references: [id])
  maintenances Maintenance[]
  alerts       Alert[]

  @@index([code])
  @@index([status])
  @@index([machineTypeId])
  @@map("machines")
}

model MaintenanceType {
  id            String              @id @default(uuid())
  name          String              @unique
  description   String?
  isPreventive  Boolean             @default(true) @map("is_preventive")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")

  maintenances Maintenance[]

  @@map("maintenance_types")
}

model Maintenance {
  id                    String            @id @default(uuid())
  machineId             String            @map("machine_id")
  maintenanceTypeId     String            @map("maintenance_type_id")
  technicianId          String            @map("technician_id")
  receivedDate          DateTime          @map("received_date")
  maintenanceDate       DateTime?         @map("maintenance_date")
  currentHours          Float             @map("current_hours")
  description           String
  observations          String?
  hoursUntilNext        Float?            @map("hours_until_next")
  nextMaintenanceDate   DateTime?         @map("next_maintenance_date")
  estimatedNextDate     DateTime?         @map("estimated_next_date")
  status                MaintenanceStatus @default(SCHEDULED)
  completedAt           DateTime?         @map("completed_at")
  cancelledAt           DateTime?         @map("cancelled_at")
  cancelReason          String?           @map("cancel_reason")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  machine          Machine          @relation(fields: [machineId], references: [id])
  maintenanceType  MaintenanceType  @relation(fields: [maintenanceTypeId], references: [id])
  technician       User             @relation("TechnicianMaintenances", fields: [technicianId], references: [id])
  items            MaintenanceItem[]
  alerts           Alert[]

  @@index([machineId])
  @@index([status])
  @@index([receivedDate])
  @@index([nextMaintenanceDate])
  @@map("maintenances")
}

model MaintenanceItem {
  id              String      @id @default(uuid())
  maintenanceId   String      @map("maintenance_id")
  name            String
  quantity        Int         @default(1)
  unitCost        Float?      @map("unit_cost")
  supplier        String?
  category        String?
  createdAt       DateTime    @default(now()) @map("created_at")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@map("maintenance_items")
}

model Alert {
  id              String          @id @default(uuid())
  machineId       String          @map("machine_id")
  maintenanceId   String?         @map("maintenance_id")
  type            AlertType
  message         String
  severity        AlertSeverity   @default(MEDIUM)
  isRead          Boolean         @default(false) @map("is_read")
  readAt          DateTime?       @map("read_at")
  readById        String?         @map("read_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  machine     Machine      @relation(fields: [machineId], references: [id])
  maintenance Maintenance? @relation(fields: [maintenanceId], references: [id])
  readBy      User?        @relation("AlertReader", fields: [readById], references: [id])

  @@index([machineId])
  @@index([isRead])
  @@index([type])
  @@index([severity])
  @@map("alerts")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  message     String
  type        String
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  readById    String?   @map("read_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  user     User   @relation(fields: [userId], references: [id])
  readBy   User?  @relation("NotificationReader", fields: [readById], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?     @map("user_id")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id")
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
